# Template only. Copy to a file outside this repository, set mode 600, and fill
# every required value with the NAS operator's private values.
# The client and tailnet origins must be private HTTPS origins under your control.

PORTFOLIO_API_GW_HTTP_PORT=8000
PORTFOLIO_WEB_PORT=8080
PORTFOLIO_SCHEMA_FILE=<ABSOLUTE_PORTFOLIO_SCHEMA_PATH>
PORTFOLIO_PUBLIC_DIR=<ABSOLUTE_CURATED_PUBLIC_DIR>
PORTFOLIO_CADDYFILE=<ABSOLUTE_NAS_CADDYFILE_PATH>
PORTFOLIO_MARKET_BUILD_CONTEXT=<ABSOLUTE_MARKET_SERVICE_CONTEXT>
SUPABASE_PUBLIC_URL=https://<PRIVATE_PORTFOLIO_ORIGIN>
API_EXTERNAL_URL=https://<PRIVATE_PORTFOLIO_ORIGIN>/auth/v1
SITE_URL=https://<PRIVATE_PORTFOLIO_ORIGIN>
ADDITIONAL_REDIRECT_URLS=https://<PRIVATE_PORTFOLIO_ORIGIN>

# Required by the upstream self-hosted Compose file. Keep these values outside git.
POSTGRES_PASSWORD=<SET_OUTSIDE_REPO>
JWT_SECRET=<SET_OUTSIDE_REPO>
ANON_KEY=<SET_OUTSIDE_REPO>
SERVICE_ROLE_KEY=<SET_OUTSIDE_REPO>
PG_META_CRYPTO_KEY=<SET_OUTSIDE_REPO>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<SET_OUTSIDE_REPO>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<SET_OUTSIDE_REPO>
SECRET_KEY_BASE=<SET_OUTSIDE_REPO>
VAULT_ENC_KEY=<SET_OUTSIDE_REPO>
PORTFOLIO_AGE_RECIPIENT=<SET_OUTSIDE_REPO>
PORTFOLIO_AGE_IDENTITY_FILE=<SET_OUTSIDE_REPO>
PORTFOLIO_DB_NAME=<SET_OUTSIDE_REPO>
PORTFOLIO_PRODUCTION_DB=<SET_OUTSIDE_REPO>
PORTFOLIO_PRODUCTION_CONTAINER=<SET_OUTSIDE_REPO>
PORTFOLIO_PRE_ACTION_RECEIPT_DIR=<SET_OUTSIDE_REPO>
