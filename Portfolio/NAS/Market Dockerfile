FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

WORKDIR /opt/portfolio-market

# The proxy has no package dependencies. The image contains only the pinned
# Node runtime and the checked-in service source.
COPY --chown=node:node ["Market Service.js", "/opt/portfolio-market/Market Service.js"]

USER node
ENV NODE_ENV=production
EXPOSE 8081

CMD ["node", "/opt/portfolio-market/Market Service.js"]
